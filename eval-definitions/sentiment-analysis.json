                },
                "sentiment-sns": {
                    "Registry": "arearnest7/sentiment-sns:latest",
                    "Endpoints": ["sentiment-db"]
                }
            },
            "Config": {
                "Channel": "cache",
                "Aggregation": "agg"
            },
            "Payload": {
                "Type": "JSON",
                "JSON": {"Records": [{"s3": {"bucket": {"name": "workflow-full-bucket"}, "object":{"key": "review.csv"}}}]}
